# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# Jira Cloud site base URL, no trailing slash.
JIRA_BASE_URL=https://your-site.atlassian.net

# Email address of the Atlassian account that owns the API token below.
JIRA_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Jira accountId of the human who owns this pipeline's tickets -- both
# loops assign a ticket to this person if it arrives unassigned, and
# dev-loop's poll JQL requires a ticket still be assigned to them before
# picking it up. Find your own via the Atlassian REST API
# (GET /rest/api/3/myself) or the accountId shown in your Jira profile URL.
JIRA_ASSIGNEE_ACCOUNT_ID=
