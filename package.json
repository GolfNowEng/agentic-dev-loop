{
  "name": "dev-loop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:hooks": "for f in test/hooks/*.test.mjs; do node \"$f\" || exit 1; done",
    "build": "tsc",
    "check-auth": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" scripts/check-jira-auth.mjs",
    "stats": "node scripts/stats.mjs",
    "sandbox:approvals": "node scripts/sandbox-approvals.mjs",
    "cutover:migrate": "node scripts/migrate-v1-folders.mjs",
    "cutover:relabel": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" scripts/relabel-v1-refined.mjs",
    "loop": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" src/main.ts",
    "reset-project": "node src/core/reset-cli.ts",
    "reset-project:remote": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" src/core/reset-cli.ts",
    "setup-qa": "playwright install chromium",
    "eval": "bash evals/run.sh"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
